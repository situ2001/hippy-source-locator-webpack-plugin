{
  "name": "hippy-source-locator-webpack-plugin",
  "version": "0.0.3",
  "description": "Locate Hippy React component source from DevTools selections",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "require": "./dist/runtime.cjs",
      "default": "./dist/runtime.cjs"
    },
    "./debug-server-register": {
      "types": "./dist/debug-server-register.d.ts",
      "require": "./dist/debug-server-register.cjs",
      "default": "./dist/debug-server-register.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && rolldown --config rolldown.config.ts && tsc --project tsconfig.build.json",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && tsx --test __tests__/*.test.ts",
    "prepack": "pnpm run build"
  },
  "author": "OpenHippy Team",
  "license": "Apache-2.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.34.5",
  "bugs": {
    "url": "https://github.com/situ2001/hippy-source-locator-webpack-plugin/issues"
  },
  "homepage": "https://github.com/situ2001/hippy-source-locator-webpack-plugin",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/plugin-transform-react-jsx-source": "^7.21.4"
  },
  "peerDependencies": {
    "@hippy/react": ">=2.14.0 <4",
    "babel-loader": ">=8.0.0",
    "webpack": ">=4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@types/node": "20.19.43",
    "acorn": "8.18.0",
    "rimraf": "6.1.3",
    "rolldown": "^1.2.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
